{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "coverageAnalysis": "perTest",
  "cleanTempDir": "always",
  "tsconfigFile": "tsconfig.stryker-noop.json",
  "mutate": ["src/analysis/**/*.ts", "src/gpx/**/*.ts"],
  "ignorePatterns": ["test-results", "playwright-report", "coverage", ".nyc_output"],
  "reporters": ["progress", "clear-text", "html"],
  "thresholds": { "break": 50 },
  "htmlReporter": {
    "fileName": "reports/mutation.html"
  },
  "timeoutMS": 20000
}
